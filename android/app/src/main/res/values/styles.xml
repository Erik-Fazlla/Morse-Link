<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Morse is dark-only: same dark window in light and dark OS mode,
         so the system bars never show a white strip. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/morse_background</item>
        <item name="android:navigationBarColor">@color/morse_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/morse_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
